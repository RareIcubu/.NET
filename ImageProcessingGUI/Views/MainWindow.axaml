<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ImageProcessingGUI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="ImageProcessingGUI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Przetwarzanie obrazów - Wątki" Width="1000" Height="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SystemRegionBrush}">
    
    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto, *">
        <!-- Header Panel -->
        <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" 
                Padding="15" BorderBrush="{DynamicResource SystemControlBaseLowBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto, Auto, *">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                    <Button Name="LoadBtn" Content="Load Image" Click="LoadBtn_Click" 
                            Classes="accent" Padding="15,8" FontWeight="SemiBold"/>
                    <Button Name="ProcessBtn" Content="Parallel Processing" Command="{Binding ProcessImagesCommand}" 
                            Padding="15,8" FontWeight="SemiBold"/>
                </StackPanel>
                
                <TextBlock Grid.Column="2" Text="{Binding StatusText}" VerticalAlignment="Center" 
                           HorizontalAlignment="Right" FontWeight="SemiBold" 
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           Margin="0,0,10,0"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" ColumnDefinitions="*, *" Margin="20" >
            
            <!-- Original Image Section -->
            <Border Grid.Column="0" Margin="0,0,10,0" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    CornerRadius="8" Padding="10" BoxShadow="0 4 8 0 #40000000">
                <Grid RowDefinitions="Auto, *">
                    <TextBlock Grid.Row="0" Text="Original Image" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                    <Border Grid.Row="1" Background="{DynamicResource SystemControlBackgroundChromeBlackLowBrush}" CornerRadius="4" ClipToBounds="True">
                        <Image Source="{Binding OriginalImage}" Stretch="Uniform" />
                    </Border>
                </Grid>
            </Border>

            <!-- Processed Images Section -->
            <Border Grid.Column="1" Margin="10,0,0,0" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    CornerRadius="8" Padding="10" BoxShadow="0 4 8 0 #40000000">
                <Grid RowDefinitions="Auto, *">
                    <TextBlock Grid.Row="0" Text="Processed Filters" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                    
                    <Grid Grid.Row="1" RowDefinitions="*, *" ColumnDefinitions="*, *">
                        <Border Grid.Row="0" Grid.Column="0" Margin="5" Background="{DynamicResource SystemControlBackgroundChromeBlackLowBrush}" CornerRadius="4" ClipToBounds="True">
                            <Image Source="{Binding Filter1Image}" Stretch="Uniform" />
                        </Border>
                        <Border Grid.Row="0" Grid.Column="1" Margin="5" Background="{DynamicResource SystemControlBackgroundChromeBlackLowBrush}" CornerRadius="4" ClipToBounds="True">
                            <Image Source="{Binding Filter2Image}" Stretch="Uniform" />
                        </Border>
                        <Border Grid.Row="1" Grid.Column="0" Margin="5" Background="{DynamicResource SystemControlBackgroundChromeBlackLowBrush}" CornerRadius="4" ClipToBounds="True">
                            <Image Source="{Binding Filter3Image}" Stretch="Uniform" />
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Margin="5" Background="{DynamicResource SystemControlBackgroundChromeBlackLowBrush}" CornerRadius="4" ClipToBounds="True">
                            <Image Source="{Binding Filter4Image}" Stretch="Uniform" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>